---
import Base from './Base.astro';
import { korDate } from '../lib/format';
import { categoryLabel } from '../lib/categories';
import Attachments from '../components/Attachments.astro';
import type { Attachment } from '../lib/attachments';

interface Props {
  title: string;
  date: Date;
  category?: string;
  tags?: string[];
  attachments?: Attachment[];
  description?: string;
  backHref: string;
  backLabel: string;
}

const {
  title,
  date,
  category,
  tags = [],
  attachments = [],
  description,
  backHref,
  backLabel,
} = Astro.props;
const label = categoryLabel(category);
---

<Base title={title} description={description} narrow>
  <article>
    <header>
      <a href={backHref} class="back mono">{backLabel}</a>
      <h1>{title}</h1>
      <div class="meta mono">
        <span>{korDate(date)}</span>
        {label && <span class="chip">{label}</span>}
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
    <Attachments items={attachments} />
  </article>
</Base>

<style>
  header {
    margin: 4rem 0 3rem;
  }

  .back {
    position: relative;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  /* 글줄 밖으로 뺀다. 이 글자와 아래 제목의 왼쪽 끝이 같아진다 */
  .back::before {
    content: '←';
    position: absolute;
    left: calc(var(--hang) * -1);
    top: 0;
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    font-size: var(--t-2);
    font-weight: 700;
    line-height: 1.25;
    margin: 1rem 0 0.75rem;
    letter-spacing: var(--track-2);
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
</style>
