---
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props { title?: string; description?: string; narrow?: boolean; home?: boolean }
const { title, description = '보안 컨설팅과 컴퓨터 과학을 공부하며 쌓는 기록', narrow = false, home = false } = Astro.props;
const pageTitle = title ? `${title} | stacknoah` : 'stacknoah';
const nav = [
  { href: '/notes', label: 'Notes' }, { href: '/projects', label: 'Projects' },
  { href: '/articles', label: 'Articles' }, { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="stacknoah" href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <div class="journal">
      <header class="site-header">
        <a href="/" class="brand" aria-label="stacknoah 홈">stacknoah<span aria-hidden="true">_</span></a>
        <nav aria-label="블로그 탐색">
          {nav.map((item) => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </header>
      <main class:list={{ 'reading-page': !home, narrow }}><slot /></main>
      <footer class="site-footer">
        <span>Song Jaewoo</span>
        <span class="signature">Security consulting &amp; independent study</span>
        <div class="footer-tools"><Search /><a href="/admin/">Write ↗</a><a href="https://github.com/stacknoah" target="_blank" rel="noopener noreferrer">GitHub</a><a href="/rss.xml">RSS</a></div>
      </footer>
    </div>
  </body>
</html>
<style>
  .journal{max-width:1240px;padding:0 clamp(24px,5vw,76px);margin:auto}
  .site-header{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:32px 0 27px;line-height:normal}
  .brand{font-size:1.65rem;font-weight:680;letter-spacing:-.065em}
  .brand span{display:inline-block;margin-left:2px;color:#22928f;animation:cursor-blink 1.2s steps(1,end) 3}
  nav{display:flex;gap:28px;font-size:.875rem}
  nav a{position:relative;padding:7px 0}
  nav a::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:1px;background:#16857d;transform:scaleX(0);transform-origin:left;transition:transform .18s}
  nav a:hover,nav a[aria-current]{color:var(--accent-ink)}
  nav a:hover::after,nav a:focus-visible::after,nav a[aria-current]::after{transform:scaleX(1)}
  .reading-page{border-top:1px solid var(--ink);min-height:60vh;padding-bottom:2rem}
  .reading-page.narrow{max-width:var(--w-text);margin:auto}
  .site-footer{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-top:42px;border-top:1px solid var(--line);padding:18px 0 25px;font-size:.75rem;color:var(--ink-3)}
  .footer-tools{display:flex;align-items:center;gap:16px}
  .footer-tools a:hover{color:var(--accent-ink)}
  @keyframes cursor-blink{0%,100%{opacity:1}50%{opacity:.2}}
  @media(max-width:700px){.journal{padding:0 24px}.site-header{flex-wrap:wrap;padding:24px 0 22px;gap:14px}nav{gap:20px}.site-footer{margin-top:32px;flex-wrap:wrap}.signature{display:none}}
  @media(prefers-reduced-motion:reduce){.brand span{animation:none}nav a::after{transition:none}}
</style>
