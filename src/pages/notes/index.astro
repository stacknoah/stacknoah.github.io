---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const byYear = new Map<number, typeof notes>();
for (const n of notes) {
  const y = n.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(n);
}
---

<Base title="Notes">
  <header class="page-head rise">
    <h1>Notes</h1>
  </header>

  {notes.length > 0 && <CategoryFilter />}

  <div class="sheet one rise rise-2">
    {
      [...byYear.entries()].map(([year, list]) => (
        <section class="mod" data-filter-group>
          <p class="mod-head">
            <span class="no">{year}</span>
            <span class="lead" aria-hidden="true" />
            <span class="val">{list.length}</span>
          </p>
          <div class="mod-body">
            {list.map((n) => (
              <PostRow
                href={`/notes/${n.id}`}
                date={n.data.date}
                title={n.data.title}
                category={n.data.category}
                tags={n.data.tags}
              />
            ))}
          </div>
        </section>
      ))
    }
    {
      notes.length === 0 && (
        <section class="mod">
          <p class="mod-head">notes<span class="lead" aria-hidden="true" /></p>
          <div class="mod-body">
            <div class="blank" role="img" aria-label="아직 쓴 노트가 없음">
              <span />
              <span />
              <span />
            </div>
          </div>
        </section>
      )
    }
  </div>
  <p class="empty" data-filter-empty hidden>이 분류에 해당하는 노트가 없음</p>
</Base>

<style>
  .one {
    grid-template-columns: minmax(0, 1fr);
  }

  .empty {
    color: var(--ink-3);
    font-size: 0.9375rem;
  }
</style>
