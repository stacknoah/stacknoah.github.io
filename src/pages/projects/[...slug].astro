---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { korDate, ymd } from '../../lib/format';
import { domainLabel } from '../../lib/categories';
import Attachments from '../../components/Attachments.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const statusLabel = { ongoing: '진행 중', done: '완료', paused: '중단' } as const;

const logs = (await getCollection('logs', (l) => l.data.project === entry.id)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const rendered = await Promise.all(
  logs.map(async (log) => ({ log, Content: (await render(log)).Content }))
);

const period = `${ymd(entry.data.start)} ~ ${entry.data.end ? ymd(entry.data.end) : '현재'}`;
---

<Base title={entry.data.title} description={entry.data.summary} narrow>
  <article>
    <header>
      <a href="/projects" class="back mono">← Projects</a>
      <h1>{entry.data.title}</h1>
      <div class="meta mono">
        <span class:list={['status', entry.data.status]}>
          <span class="dot" />
          {statusLabel[entry.data.status]}
        </span>
        {domainLabel(entry.data.domain) && (
          <span class="chip">{domainLabel(entry.data.domain)}</span>
        )}
        <span>{period}</span>
        {
          entry.data.repo && (
            <a href={entry.data.repo} class="link" target="_blank" rel="noopener">
              github
            </a>
          )
        }
        {entry.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <p class="summary">{entry.data.summary}</p>
    </header>

    <div class="prose">
      <Content />
    </div>
    <Attachments items={entry.data.attachments} />

    {
      rendered.length > 0 && (
        <section class="timeline">
          <p class="section-label">log</p>
          {rendered.map(({ log, Content: LogContent }) => (
            <div class="log">
              <div class="log-head">
                <span class="log-date mono">{korDate(log.data.date)}</span>
                <span class="log-title">{log.data.title}</span>
              </div>
              <div class="prose log-body">
                <LogContent />
              </div>
            </div>
          ))}
        </section>
      )
    }
  </article>
</Base>

<style>
  header {
    margin: 4rem 0 2.5rem;
  }

  .back {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 1rem 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-size: 0.75rem;
    color: var(--ink-3);
    flex-wrap: wrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-2);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .status.ongoing .dot {
    background: var(--accent);
  }

  .status.paused .dot {
    background: var(--line);
  }

  .summary {
    color: var(--ink-2);
    margin: 1rem 0 0;
  }

  .timeline {
    margin-top: 4rem;
  }

  .log {
    padding: 1.5rem 0;
  }

  .log + .log {
    border-top: 1px solid var(--line);
  }

  .log-head {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .log-date {
    font-size: 0.75rem;
    color: var(--ink-3);
    flex-shrink: 0;
  }

  .log-title {
    font-weight: 600;
    font-size: 1rem;
  }

  .log-body {
    font-size: 0.9375rem;
  }
</style>
