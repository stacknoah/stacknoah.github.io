---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ymd } from '../../lib/format';
import { domainLabel } from '../../lib/categories';
import Attachments from '../../components/Attachments.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const statusLabel = { ongoing: '진행 중', done: '완료', paused: '중단' } as const;

const period = `${ymd(entry.data.start)} ~ ${entry.data.end ? ymd(entry.data.end) : '현재'}`;
---

<Base title={entry.data.title} description={entry.data.summary} narrow>
  <article>
    <header>
      <a href="/projects" class="back mono">Projects</a>
      <h1>{entry.data.title}</h1>
      <div class="meta mono">
        <span class:list={['status', entry.data.status]}>
          <span class="dot" />
          {statusLabel[entry.data.status]}
        </span>
        {domainLabel(entry.data.domain) && (
          <span class="chip">{domainLabel(entry.data.domain)}</span>
        )}
        <span>{period}</span>
        {
          entry.data.repo && (
            <a href={entry.data.repo} class="link" target="_blank" rel="noopener">
              github
            </a>
          )
        }
        {entry.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <p class="summary">{entry.data.summary}</p>
    </header>

    <div class="prose">
      <Content />
    </div>
    <Attachments items={entry.data.attachments} />

  </article>
</Base>

<style>
  header {
    margin: 4rem 0 2.5rem;
  }

  .back {
    position: relative;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .back::before {
    content: '←';
    position: absolute;
    left: calc(var(--hang) * -1);
    top: 0;
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    font-size: var(--t-2);
    font-weight: 700;
    line-height: 1.25;
    margin: 1rem 0 0.75rem;
    letter-spacing: var(--track-2);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-size: 0.75rem;
    color: var(--ink-3);
    flex-wrap: wrap;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-2);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
  }

  .status.ongoing .dot {
    background: var(--accent);
  }

  .status.paused .dot {
    background: var(--line);
  }

  .summary {
    color: var(--ink-2);
    margin: 1rem 0 0;
  }

</style>
