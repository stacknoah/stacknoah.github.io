---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import { ymd } from '../../lib/format';
import { categoryLabel } from '../../lib/categories';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="Articles">
  <header class="page-head rise">
    <h1>Articles</h1>
  </header>

  {articles.length > 0 && <CategoryFilter />}

  <div class="sheet one rise rise-2">
  <section class="mod">
    <p class="mod-head">
      articles
      <span class="lead" aria-hidden="true" />
      {articles.length > 0 && <span class="val">{articles.length}</span>}
    </p>
    <div class="mod-body list">
    {
      articles.map((a) => (
        <a href={`/articles/${a.id}`} class="item" data-category={a.data.category ?? ''}>
          <div class="item-head">
            <span class="item-left">
              {categoryLabel(a.data.category) && (
                <span class="chip">{categoryLabel(a.data.category)}</span>
              )}
              <span class="item-title">{a.data.title}</span>
            </span>
            <span class="date mono">{ymd(a.data.date)}</span>
          </div>
          {a.data.description && <p class="desc">{a.data.description}</p>}
          {a.data.tags.length > 0 && (
            <div class="tags">
              {a.data.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )}
        </a>
      ))
    }
    {
      articles.length === 0 && (
        <div class="blank" role="img" aria-label="아직 쓴 글이 없음">
          <span />
          <span />
          <span />
        </div>
      )
    }
    </div>
  </section>
  </div>
  <p class="empty" data-filter-empty hidden>이 분류에 해당하는 글이 없음</p>
</Base>

<style>
  .one {
    grid-template-columns: minmax(0, 1fr);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .item {
    display: block;
    padding: 1.125rem 1.125rem;
    margin: 0 -1.125rem;
    border-radius: 12px;
    transition: background 0.15s ease;
  }

  .item:hover {
    background: var(--surface);
  }

  .item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .item-left {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    min-width: 0;
  }

  .item-title {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .item:hover .item-title {
    color: var(--accent-ink);
  }

  .date {
    font-size: 0.75rem;
    color: var(--ink-3);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .desc {
    margin: 0.375rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .empty {
    color: var(--ink-3);
    font-size: 0.9375rem;
  }
</style>
