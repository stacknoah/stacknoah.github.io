---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StudyHome from '../components/StudyHome';
import { webSource, type DailyRecord } from '../lib/daily';

const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const posts = new Map<string, string>();
for (const collection of ['notes', 'articles', 'projects', 'chapters'] as const) {
  for (const entry of await getCollection(collection)) {
    posts.set(`/${collection === 'chapters' ? 'projects' : collection}/${entry.id}`, entry.data.title);
  }
}
const records: DailyRecord[] = (await getCollection('daily'))
  .map(({ id, data }) => {
    const sources = [];
    if (data.post && posts.has(data.post)) sources.push({ title: posts.get(data.post)!, href: data.post, external: false });
    const external = data.sourceUrl && webSource(data.sourceTitle ?? '', data.sourceUrl, Astro.site!.href);
    if (external && !sources.some((source) => source.href === external.href)) sources.push(external);
    return { id, date: data.date.toISOString().slice(0, 10), text: data.title, sources };
  })
  .filter((record) => record.date <= today)
  .sort((a, b) => a.date.localeCompare(b.date) || a.id.localeCompare(b.id));
---

<Base home description="매일 배운 것을 한 줄씩 쌓는 기록. IT, OT와 컴퓨터 과학.">
  <StudyHome records={records} today={today} client:load />
</Base>
