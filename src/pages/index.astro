---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Activity from '../components/Activity.astro';
import Roadmap from '../components/Roadmap.astro';
import Projects from '../components/Projects.astro';
import { ymd } from '../lib/format';
import type { ActivityEntry } from '../components/Activity.astro';

const notes = await getCollection('notes');
const articles = await getCollection('articles');
const chapters = await getCollection('chapters');

// 홈 오른쪽 칸에 보이는 글. 최신 3편, 없으면 빈 줄 셋이 자리를 지킨다
const recent = [...articles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// 표제란. 도면 한 장의 이름, 분야, 갱신일, 수량
const projects = await getCollection('projects');
const built = new Date();
const stamp = `${String(built.getFullYear()).slice(2)}.${String(built.getMonth() + 1).padStart(2, '0')}.${String(built.getDate()).padStart(2, '0')}`;
const written = notes.length + articles.length + chapters.length;

const entries: ActivityEntry[] = [
  ...notes.map((e) => ({
    date: ymd(e.data.date),
    title: e.data.title,
    kind: '노트' as const,
    href: `/notes/${e.id}`,
  })),
  ...articles.map((e) => ({
    date: ymd(e.data.date),
    title: e.data.title,
    kind: '글' as const,
    href: `/articles/${e.id}`,
  })),
  // 연재 세부 페이지도 글이다. 밭에 찍히고 편수에 든다
  ...chapters.map((e) => ({
    date: ymd(e.data.date),
    title: e.data.title,
    kind: '글' as const,
    href: `/projects/${e.id}`,
  })),
];
---

<Base>
  <section class="sheet tb rise" aria-label="표제란">
    <div class="cell name">stacknoah</div>
    <div class="cell grow">security consulting · it / ot</div>
    <div class="cell">rev <b>{stamp}</b></div>
    <div class="cell">
      글 <b>{written}</b>
      <span class="sep" aria-hidden="true">/</span>
      프로젝트 <b>{projects.length}</b>
    </div>
  </section>

  <section class="sheet grid rise rise-2">
    <div class="mod act">
      <p class="mod-head">
        <span class="no">01</span>
        activity
        <span class="lead" aria-hidden="true"></span>
        {written > 0 && <span class="val">{written}편</span>}
      </p>
      <div class="mod-body">
        <Activity entries={entries} head={false} />
      </div>
    </div>

    <div class="mod">
      <p class="mod-head">
        <span class="no">02</span>
        projects
        <span class="lead" aria-hidden="true"></span>
        <a href="/projects" class="all" aria-label="프로젝트 전부 보기">→</a>
      </p>
      <div class="mod-body">
        <Projects limit={1} />
      </div>
    </div>

    <div class="mod">
      <p class="mod-head">
        <span class="no">03</span>
        articles
        <span class="lead" aria-hidden="true"></span>
        <a href="/articles" class="all" aria-label="글 전부 보기">→</a>
      </p>
      <div class="mod-body">
        {
          recent.length > 0 ? (
            <ul class="arows">
              {recent.map((a) => (
                <li>
                  <a class="arow" href={`/articles/${a.id}`}>
                    <span class="d mono">{ymd(a.data.date).slice(5).replace('-', '.')}</span>
                    <span class="t">{a.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="blank" role="img" aria-label="아직 쓴 글이 없음">
              <span />
              <span />
              <span />
            </div>
          )
        }
      </div>
    </div>

    <div class="mod wide">
      <p class="mod-head">
        <span class="no">04</span>
        notes
        <span class="lead" aria-hidden="true"></span>
        <a href="/notes" class="all" aria-label="노트 전부 보기">→</a>
      </p>
      <div class="mod-body">
        <Roadmap />
      </div>
    </div>
  </section>
</Base>

<style>
  .tb {
    margin-top: 1.75rem;
  }

  .sep {
    color: var(--line-strong);
  }

  /* 밭이 왼쪽 두 줄을 차지하고, 오른쪽에 프로젝트와 글이 위아래로 앉는다.
     칸이 서로 선을 나눠 쓰니 높이는 저절로 맞는다 */
  .grid {
    margin-top: 1.25rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    grid-auto-rows: auto;
  }

  .act {
    grid-row: 1 / span 2;
  }

  .wide {
    grid-column: 1 / -1;
  }

  /* 좁은 칸의 글 한 줄. 날짜와 제목만 */
  .arows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .arows li + li {
    margin-top: 0.25rem;
  }

  .arow {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.3rem var(--hang);
    margin: 0 calc(var(--hang) * -1);
    border-radius: 4px;
    transition: background var(--out) ease;
  }

  .arow:hover {
    background: var(--accent-08);
    transition-duration: var(--in);
  }

  .arow .d {
    flex-shrink: 0;
    font-size: var(--t-8);
    letter-spacing: var(--track-en);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .arow .t {
    font-size: var(--t-6);
    font-weight: 500;
    letter-spacing: var(--track-4);
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--out) ease;
  }

  .arow:hover .t {
    color: var(--accent-ink);
    transition-duration: var(--in);
  }

  .mod-body .blank {
    padding-top: 0.25rem;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .act {
      grid-row: auto;
    }
  }
</style>
