---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Activity from '../components/Activity.astro';
import Roadmap from '../components/Roadmap.astro';
import Projects from '../components/Projects.astro';
import PostRow from '../components/PostRow.astro';
import { ymd } from '../lib/format';
import type { ActivityEntry } from '../components/Activity.astro';

const notes = await getCollection('notes');
const articles = await getCollection('articles');

// 홈에 보이는 글. 최신 3편, 없으면 빈 줄 셋이 자리를 지킨다
const recent = [...articles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const entries: ActivityEntry[] = [
  ...notes.map((e) => ({
    date: ymd(e.data.date),
    title: e.data.title,
    kind: '노트' as const,
    href: `/notes/${e.id}`,
  })),
  ...articles.map((e) => ({
    date: ymd(e.data.date),
    title: e.data.title,
    kind: '글' as const,
    href: `/articles/${e.id}`,
  })),
];
---

<Base>
  <section class="hero rise">
    <h1 class="mono">stacknoah<span class="cursor">_</span></h1>
  </section>

  <section class="block split rise rise-2">
    <div class="col activity">
      <Activity entries={entries} />
    </div>
    <div class="col">
      <p class="section-label">
        projects
        <span class="lead" aria-hidden="true"></span>
        <a href="/projects" class="all" aria-label="프로젝트 전부 보기">→</a>
      </p>
      <Projects limit={2} />
    </div>
  </section>

  <section class="block writing rise rise-3">
    <p class="section-label">
      articles
      <span class="lead" aria-hidden="true"></span>
      <a href="/articles" class="all" aria-label="글 전부 보기">→</a>
    </p>
    {
      recent.length > 0 ? (
        <div class="list">
          {recent.map((a) => (
            <PostRow
              href={`/articles/${a.id}`}
              date={a.data.date}
              title={a.data.title}
              category={a.data.category}
              tags={a.data.tags}
            />
          ))}
        </div>
      ) : (
        <div class="blank" role="img" aria-label="아직 쓴 글이 없음">
          <span />
          <span />
          <span />
        </div>
      )
    }
  </section>

  <section class="block rise rise-3">
    <p class="section-label">roadmap<span class="lead" aria-hidden="true"></span></p>
    <Roadmap />
  </section>
</Base>

<style>
  .hero {
    margin: 5rem 0 3rem;
  }

  .hero h1 {
    font-size: var(--t-1);
    font-weight: 700;
    margin: 0;
    letter-spacing: var(--track-1);
    line-height: 1.1;
  }

  .cursor {
    color: var(--accent-mid);
    /* 무한에서 세 번으로. 쉬는 화면에서 혼자 움직이는 것이 없어야 한다 */
    animation: blink 1.2s steps(1) 3;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* 큰 쉼은 페이지에 한 번뿐. 로드맵 아래는 main 의 padding-bottom 이 받는다 */
  .block {
    margin-bottom: 0;
  }

  .writing {
    margin-bottom: 5rem;
  }

  @media (max-width: 960px) {
    .writing {
      margin-bottom: 4rem;
    }
  }

  /* 왼쪽 히트맵, 오른쪽 프로젝트 */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: 4rem;
    align-items: start;
    margin-bottom: 5rem;
  }

  /* 전부 보기로 가는 화살표 */
  .all {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--ink-3);
    transition: color var(--out) ease, transform var(--out) var(--ease);
  }

  .all:hover {
    color: var(--accent-ink);
    transform: translateX(3px);
    transition-duration: var(--in);
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
      margin-bottom: 4rem;
    }
  }

  /* Astro 가 컴포넌트 스타일을 스코프해서 global.css 보다 우선순위가 높다 */
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
