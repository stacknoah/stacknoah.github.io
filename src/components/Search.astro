---
// 사이트 검색. 빌드 때 만든 /search.json 을 처음 열 때 한 번만 받아와 화면에서 거름
---

<button type="button" class="open" data-search-open aria-label="검색 열기">
  <svg viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="7" cy="7" r="4.5"></circle>
    <path d="M10.5 10.5 L14 14"></path>
  </svg>
  <span class="hint mono">/</span>
</button>

<div class="overlay" data-search-overlay hidden>
  <div class="backdrop" data-search-close></div>
  <div class="panel" role="dialog" aria-modal="true" aria-label="검색">
    <div class="field">
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5"></circle>
        <path d="M10.5 10.5 L14 14"></path>
      </svg>
      <input
        type="search"
        data-search-input
        placeholder="제목, 태그, 본문에서 찾기"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="mono">esc</kbd>
    </div>
    <div class="results" data-search-results></div>
  </div>
</div>

<script>
  interface Doc {
    url: string;
    kind: string;
    title: string;
    category: string;
    tags: string[];
    desc: string;
    text: string;
  }

  const overlay = document.querySelector<HTMLElement>('[data-search-overlay]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');

  if (overlay && input && results) {
    let docs: Doc[] | null = null;
    let active = 0;

    async function load() {
      if (docs) return docs;
      const res = await fetch('/search.json');
      docs = (await res.json()) as Doc[];
      return docs;
    }

    function esc(s: string) {
      return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    }

    // 본문에서 검색어 주변만 잘라 보여줌
    function snippet(text: string, q: string) {
      const i = text.toLowerCase().indexOf(q);
      if (i < 0) return '';
      const from = Math.max(0, i - 30);
      const cut = text.slice(from, from + 110);
      return (from > 0 ? '…' : '') + cut + (from + 110 < text.length ? '…' : '');
    }

    function score(d: Doc, q: string) {
      const t = d.title.toLowerCase();
      if (t === q) return 100;
      if (t.startsWith(q)) return 80;
      if (t.includes(q)) return 60;
      if (d.tags.some((x) => x.toLowerCase().includes(q))) return 45;
      if (d.category.toLowerCase().includes(q)) return 40;
      if (d.desc.toLowerCase().includes(q)) return 30;
      if (d.text.toLowerCase().includes(q)) return 15;
      return 0;
    }

    function render(list: (Doc & { _s: number })[], q: string) {
      active = 0;
      if (!q) {
        results.innerHTML = '<p class="msg">제목과 태그, 본문에서 찾습니다</p>';
        return;
      }
      if (list.length === 0) {
        results.innerHTML = `<p class="msg">"${esc(q)}"에 해당하는 글이 없음</p>`;
        return;
      }
      results.innerHTML = list
        .map((d, i) => {
          const sn = d._s <= 15 ? snippet(d.text, q) : d.desc;
          return `<a class="hit${i === 0 ? ' on' : ''}" href="${d.url}">
            <span class="hit-head">
              <span class="hit-kind mono">${esc(d.kind)}</span>
              ${d.category ? `<span class="chip">${esc(d.category)}</span>` : ''}
              <span class="hit-title">${esc(d.title)}</span>
            </span>
            ${sn ? `<span class="hit-sub">${esc(sn)}</span>` : ''}
          </a>`;
        })
        .join('');
    }

    function search() {
      const q = input!.value.trim().toLowerCase();
      if (!docs) return;
      const list = docs
        .map((d) => ({ ...d, _s: score(d, q) }))
        .filter((d) => d._s > 0)
        .sort((a, b) => b._s - a._s)
        .slice(0, 8);
      render(list, q);
    }

    function move(step: number) {
      const hits = [...results!.querySelectorAll<HTMLAnchorElement>('.hit')];
      if (hits.length === 0) return;
      hits[active]?.classList.remove('on');
      active = (active + step + hits.length) % hits.length;
      hits[active].classList.add('on');
      hits[active].scrollIntoView({ block: 'nearest' });
    }

    async function open() {
      overlay!.hidden = false;
      document.body.style.overflow = 'hidden';
      input!.focus();
      await load();
      search();
    }

    function close() {
      overlay!.hidden = true;
      document.body.style.overflow = '';
      input!.value = '';
      results!.innerHTML = '';
    }

    for (const btn of document.querySelectorAll('[data-search-open]')) {
      btn.addEventListener('click', open);
    }
    for (const el of document.querySelectorAll('[data-search-close]')) {
      el.addEventListener('click', close);
    }
    input.addEventListener('input', search);

    document.addEventListener('keydown', (e) => {
      const typing =
        e.target instanceof HTMLElement &&
        (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA');

      if (!overlay!.hidden) {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        else if (e.key === 'Enter') {
          const hit = results!.querySelector<HTMLAnchorElement>('.hit.on');
          if (hit) { e.preventDefault(); location.href = hit.href; }
        }
        return;
      }

      if (!typing && (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key === 'k'))) {
        e.preventDefault();
        open();
      }
    });
  }
</script>

<style>
  .open {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: none;
    border: 0;
    padding: 0.15rem 0.25rem;
    cursor: pointer;
    color: var(--ink-3);
    transition: color 0.15s ease;
  }

  .open:hover {
    color: var(--ink);
  }

  .open svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .hint {
    font-size: 0.6875rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 0.25rem;
    line-height: 1.4;
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    background: rgba(25, 25, 24, 0.28);
  }

  .panel {
    position: relative;
    max-width: 34rem;
    margin: 12vh auto 0;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .field svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font-family: inherit;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  kbd {
    font-size: 0.6875rem;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 0.3rem;
  }

  .results {
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.375rem;
  }

  .results :global(.msg) {
    margin: 0;
    padding: 1.25rem 0.75rem;
    font-size: 0.875rem;
    color: var(--ink-3);
  }

  .results :global(.hit) {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 9px;
  }

  .results :global(.hit.on) {
    background: var(--surface);
  }

  .results :global(.hit-head) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .results :global(.hit-kind) {
    font-size: 0.6875rem;
    color: var(--ink-3);
    flex-shrink: 0;
  }

  .results :global(.hit-title) {
    font-size: 0.9375rem;
    font-weight: 550;
    color: var(--ink);
  }

  .results :global(.hit.on .hit-title) {
    color: var(--accent-ink);
  }

  .results :global(.hit-sub) {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hint {
      display: none;
    }
    .panel {
      margin-top: 6vh;
      max-width: none;
      margin-left: 1rem;
      margin-right: 1rem;
    }
  }
</style>
