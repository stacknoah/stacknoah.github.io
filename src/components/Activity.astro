---
// 지난 6개월의 날들을 주 단위 열로 깐 밭이다. 한 칸이 하루.
// 빈 날은 배경의 옅은 점이고, 글 쓴 날에만 터키석 가로 막대가 눕는다.
// 막대는 로고의 rect 와 같은 문법이다. 이 사이트의 마크가 밭에 심긴다.
// 그날 몇 편을 썼는지는 색이 아니라 막대의 길이로 갈린다. 로고의 세 막대가
// 폭으로 갈리는 것과 같고, 흑백으로 찍어도 같게 읽힌다.
//
// 안 쓴 날은 안 쓴 날로 보인다. 마지막 막대와 오늘 사이의 빈 칸들이
// 그대로 쌓이고, 오늘 칸 아래에는 며칠째 비었는지가 하루마다 올라간다.

export interface ActivityEntry {
  date: string; // YYYY-MM-DD
  title: string;
  kind: '노트' | '글';
  href: string;
}

interface Props {
  entries: ActivityEntry[];
  /** 몇 개월치를 보여줄지 */
  months?: number;
}

const { entries, months = 6 } = Astro.props;

const DAY = 86400000;
const MONTH = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function parseYmd(s: string): Date {
  const [y, m, d] = s.split('-').map(Number);
  return new Date(y, m - 1, d);
}

/** 서머타임이 있는 지역에서도 어긋나지 않게 반올림 */
function daysBetween(a: Date, b: Date): number {
  return Math.round((b.getTime() - a.getTime()) / DAY);
}

function mmdd(s: string): string {
  return s.slice(5).replace('-', '.');
}

const today = new Date();
today.setHours(0, 0, 0, 0);

// 창의 시작은 months 개월 전 달 1일을 품은 일요일. 안 맞추면 첫 열이
// 토막 나서 월 눈금만 한 칸 들여쓰기 된 것처럼 보인다
const firstOfMonth = new Date(today.getFullYear(), today.getMonth() - (months - 1), 1);
const start = new Date(firstOfMonth);
start.setDate(start.getDate() - start.getDay());

const span = daysBetween(start, today);
const cols = Math.floor(span / 7) + 1;

// 날짜별로 묶는다. 창 밖 글은 격자에 안 그리고 누적 편수에만 들어간다
const byDate = new Map<string, ActivityEntry[]>();
for (const e of entries) {
  const list = byDate.get(e.date);
  if (list) list.push(e);
  else byDate.set(e.date, [e]);
}

const marks: {
  key: string;
  col: number;
  row: number;
  level: number;
  items: ActivityEntry[];
}[] = [];

for (const [date, items] of byDate) {
  const idx = daysBetween(start, parseYmd(date));
  if (idx < 0 || idx > span) continue;
  marks.push({
    key: date,
    col: Math.floor(idx / 7),
    row: idx % 7,
    level: Math.min(items.length, 3),
    items,
  });
}
marks.sort((a, b) => (a.key < b.key ? -1 : 1));

const total = entries.length;

const todayRow = span % 7;
const todayCol = Math.floor(span / 7);
const aheadCount = 6 - todayRow;
const pad = (v: number) => String(v).padStart(2, '0');
const todayKey = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;
const todayDone = byDate.has(todayKey);

// 마지막 글부터 오늘까지 며칠 비었는지
const lastKey = [...byDate.keys()].sort().at(-1);
const idle = lastKey ? Math.min(span, daysBetween(parseYmd(lastKey), today)) : 0;

// 월 눈금. 그 달이 시작하는 주의 열에 왼쪽을 맞춘다
const monthTicks: { col: number; label: string }[] = [];
{
  const cursor = new Date(firstOfMonth);
  for (let i = 0; i < months; i++) {
    const idx = daysBetween(start, cursor);
    if (idx >= 0 && idx <= span) {
      monthTicks.push({ col: Math.floor(idx / 7), label: MONTH[cursor.getMonth()] });
    }
    cursor.setMonth(cursor.getMonth() + 1);
  }
}

// 말풍선이 칸 밖으로 나가는 쪽을 빌드 때 정한다
const anchor = (col: number) => (col >= cols - 6 ? ' end' : col <= 5 ? ' start' : '');
---

<div
  class="activity"
  data-activity
  data-start={`${start.getFullYear()}-${pad(start.getMonth() + 1)}-${pad(start.getDate())}`}
  data-last={lastKey ?? ''}
  style={`--cols:${cols}`}
>
  <p class="section-label">
    activity
    {
      total > 0 && (
        <Fragment>
          <span class="lead" aria-hidden="true" />
          <span class="tally">
            <b>{total}</b>
            <i>편</i>
          </span>
        </Fragment>
      )
    }
  </p>

  <div class="board">
    <div class="field">
    {
      marks.map((m) => {
        const label = `${m.key}, ${m.items.length}편`;
        const cls = `mark lv${m.level}${anchor(m.col)}`;
        const style = `--c:${m.col}; --r:${m.row}`;
        const tip = (
          <span class="tip" aria-hidden="true">
            <b>{mmdd(m.key)}</b>
            {m.items[0].title}
            {m.items.length > 1 && <em>외 {m.items.length - 1}편</em>}
          </span>
        );
        const href = m.items[0].href;
        return href ? (
          <a class={cls} style={style} href={href} aria-label={label}>
            {tip}
          </a>
        ) : (
          <span class={cls} style={style} role="img" aria-label={label}>
            {tip}
          </span>
        );
      })
    }

    {/* 오늘. 다음 막대가 눕는 자리의 커서. 워드마크처럼 세 번 깜박이고 멈춘다 */}
    <span
      class="now"
      data-now
      hidden={todayDone}
      style={`--c:${todayCol}; --r:${todayRow}`}
      aria-hidden="true"></span>

    {/* 오늘 이후는 아직 오지 않은 날이라 점도 지운다 */}
    <span
      class="ahead"
      data-ahead
      hidden={aheadCount < 1}
      style={`--c:${todayCol}; --r:${todayRow + 1}; --n:${aheadCount}`}
      aria-hidden="true"></span>
    </div>

    <div class="months" aria-hidden="true">
    {
      monthTicks.map((t) => (
        <span class={t.col > cols - 3 ? 'tick tail' : 'tick'} style={`--c:${t.col}`}>
          {t.label}
        </span>
      ))
    }
    {/* 며칠째 빈 밭인지. 오늘 칸 바로 아래에서 하루마다 올라간다 */}
    <span class="idle" data-idle hidden={idle < 1}>
      <b data-idle-n class="mono">{idle}</b>
      <i>일째</i>
    </span>
    </div>
  </div>
</div>

<script>
  // 오늘 자리는 보는 사람의 시계를 따라간다. 정적 사이트라 빌드 날짜로
  // 굳어 있어서, 오늘 커서와 앞날 가림과 빈 날수만 화면에서 다시 잰다
  const root = document.querySelector<HTMLElement>('[data-activity]');
  const startStr = root?.dataset.start;

  if (root && startStr) {
    const [y, m, d] = startStr.split('-').map(Number);
    const start = new Date(y, m - 1, d);
    const now = new Date();
    now.setHours(0, 0, 0, 0);

    const span = Math.round((now.getTime() - start.getTime()) / 86400000);
    const cols = Number(getComputedStyle(root).getPropertyValue('--cols'));
    const col = Math.min(cols - 1, Math.floor(span / 7));
    const row = span % 7;

    const el = (s: string) => root.querySelector<HTMLElement>(s);
    const nowEl = el('[data-now]');
    if (nowEl && !nowEl.hidden) {
      nowEl.style.setProperty('--c', String(col));
      nowEl.style.setProperty('--r', String(row));
    }

    const ahead = el('[data-ahead]');
    if (ahead) {
      const n = 6 - row;
      ahead.hidden = n < 1 || col >= cols;
      ahead.style.setProperty('--c', String(col));
      ahead.style.setProperty('--r', String(row + 1));
      ahead.style.setProperty('--n', String(n));
    }

    const lastStr = root.dataset.last;
    const box = el('[data-idle]');
    const num = el('[data-idle-n]');
    if (lastStr && box && num) {
      const [ly, lm, ld] = lastStr.split('-').map(Number);
      const idle = Math.round((now.getTime() - new Date(ly, lm - 1, ld).getTime()) / 86400000);
      num.textContent = String(idle);
      box.hidden = idle < 1;
    }
  }
</script>

<style>
  /* 빈 날을 도형으로 그리면 175개가 실제 기록 5개와 같은 무게로 싸운다.
     빈 날은 배경의 흔적으로 낮추고, 태그로 서는 건 글 쓴 날뿐이다.
     칸이 폭을 따라가서 미디어 쿼리도 가로 스크롤도 없다 */
  /* 라벨은 판 밖의 제 줄에 선다. 옆 칸의 라벨과 같은 가로줄이다.
     판은 밭과 월 눈금만 담는 도판이고, 안쪽 여백이 네 방향 고르다 */
  .activity {
    --px: 24px;
    /* 투명 혼합이 아니라 종이 위 불투명 혼합. 앞날 가림이 이 색으로 점을 덮는다 */
    --panel: #f2f4f2;
    --panel: color-mix(in srgb, var(--accent-ink) 4%, var(--bg));
    --grain: var(--accent-24);
  }

  /* Search 오버레이가 .panel 을 이미 쓴다. 여기는 board */
  .board {
    background: var(--panel);
    border-radius: 12px;
    /* 아래 6px 은 옆 칸과 바닥을 맞추는 값. 오른쪽 칸 내용이 바뀌면 다시 잰다 */
    padding: 1.125rem 1rem calc(0.875rem + 6px);
  }

  @supports (width: 1cqw) {
    .activity {
      container-type: inline-size;
      --px: calc(100cqw / var(--cols));
    }
  }

  /* 라벨 오른쪽 값. 숫자와 단위를 같은 크기로 둬서 5편이 한 낱말로 붙는다 */
  .tally {
    display: inline-flex;
    align-items: baseline;
    flex-shrink: 0;
  }

  .tally b {
    font-family: var(--font-mono);
    font-size: var(--t-7);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* 고정폭 스택에 한글이 없다. 여기서 다시 안 잡으면 시스템 글꼴로 떨어진다 */
  .tally i {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--t-7);
    font-weight: 500;
    letter-spacing: var(--track-ko);
    color: var(--ink-3);
    margin-left: -0.02em;
  }

  .activity :global(.section-label) {
    margin-bottom: 1.25rem;
  }

  /* 밭. 한 칸이 하루고 빈 날은 아주 짧은 가로 획 하나다.
     밭의 모든 것이 같은 가로 획 문법을 쓴다. 빈 날은 흐리고 짧게,
     글 쓴 날은 터키석으로 길게, 오늘은 짙은 잿빛으로.
     원을 섞으면 막대와 딴 식구가 되어 질감이 깨진다 */
  .field {
    position: relative;
    width: 100%;
    aspect-ratio: var(--cols) / 7;
    background-image: radial-gradient(
      ellipse 11% 4% at center,
      var(--grain, var(--line-strong)) 68%,
      transparent 100%
    );
    background-size: calc(100% / var(--cols)) calc(100% / 7);
  }

  .mark,
  .now,
  .ahead {
    position: absolute;
    left: calc(var(--c) * (100% / var(--cols)));
    top: calc(var(--r) * (100% / 7));
    width: calc(100% / var(--cols));
    height: calc(100% / 7);
  }

  .mark {
    display: grid;
    place-items: center;
  }

  /* 글 쓴 날의 막대. 로고의 rect 와 같은 문법으로 밭에 눕는다.
     편수는 색이 아니라 길이로 갈린다. 로고의 세 막대가 폭으로 갈리듯 */
  .mark::after {
    content: '';
    /* 좁은 화면에서 칸이 줄어도 최소 폭을 지킨다. 짧아지면 점으로 뭉개져
       원 금지 규칙이 무너진다. 퍼센트는 칸 폭 기준 */
    width: max(var(--w-min, 7px), var(--w, 38%));
    height: max(3.5px, calc(var(--px) * 0.17));
    border-radius: 999px;
    background: var(--accent-mid);
    transition: background var(--out) ease, transform var(--out) var(--ease);
  }

  .mark.lv2 {
    --w: 60%;
    --w-min: 9px;
  }

  .mark.lv3 {
    --w: 82%;
    --w-min: 11px;
  }

  .mark:hover::after,
  .mark:focus-visible::after {
    background: var(--accent-strong);
    transform: scaleX(1.12);
    transition-duration: var(--in);
  }

  .mark:focus-visible {
    outline: none;
  }

  /* 오늘. 다음 막대가 눕는 자리에서 기다리는 잿빛 커서.
     색이 없어서 기록으로 안 읽히고, 워드마크처럼 세 번 깜박이고 멈춘다 */
  .now {
    display: grid;
    place-items: center;
  }

  .now::after {
    content: '';
    width: max(7px, 38%);
    height: 2px;
    border-radius: 1px;
    background: var(--ink-2);
    animation: blink 1.2s steps(1) 3;
  }

  .now[hidden] {
    display: none;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* 오늘 이후. 아직 오지 않은 날이라 점도 지운다 */
  .ahead {
    height: calc(var(--n) * (100% / 7));
    background: var(--panel);
  }

  .ahead[hidden] {
    display: none;
  }

  /* 월 눈금 줄. 오른쪽 끝에는 며칠째 비었는지가 함께 앉는다 */
  .months {
    position: relative;
    height: 1.05rem;
    margin-top: 0.625rem;
  }

  .tick {
    position: absolute;
    left: calc(var(--c) * (100% / var(--cols)));
    font-family: var(--font-mono);
    font-size: var(--t-8);
    font-weight: 500;
    letter-spacing: var(--track-en);
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* 오른쪽 끝에 붙는 달은 글자가 격자 밖으로 나가지 않게 오른쪽을 맞춘다.
     빈 날수와 같은 끝을 다투면 달이 물러난다 */
  .tick.tail {
    left: auto;
    right: 0;
  }

  .idle {
    position: absolute;
    right: 0;
    display: inline-flex;
    align-items: baseline;
    /* 판 위에 앉으므로 판 색으로 월 눈금을 가린다 */
    background: var(--panel);
    padding-left: 0.5rem;
  }

  .idle[hidden] {
    display: none;
  }

  .idle b {
    font-size: var(--t-8);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .idle i {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--t-8);
    font-weight: 500;
    letter-spacing: var(--track-ko);
    color: var(--ink-3);
    margin-left: 0.02em;
  }

  /* 제목은 손이 닿을 때만. 쉬는 화면에 글자를 늘리지 않는다 */
  .tip {
    position: absolute;
    z-index: 5;
    top: calc(100% + 6px);
    left: 50%;
    transform: translate(-50%, 2px);
    width: max-content;
    max-width: 15rem;
    background: var(--bg);
    color: var(--ink);
    border-radius: 7px;
    padding: 0.4rem 0.6rem;
    font-size: var(--t-8);
    line-height: 1.5;
    word-break: keep-all;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 0 0 1px var(--line-strong), 0 2px 12px rgba(26, 26, 25, 0.06);
    transition: opacity var(--out) ease, transform var(--out) var(--ease);
  }

  .tip b {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: var(--track-en);
    margin-right: 0.3rem;
  }

  .tip em {
    font-style: normal;
    color: var(--ink-3);
    margin-left: 0.3rem;
  }

  .mark:hover .tip,
  .mark:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* 양 끝 칸은 말풍선이 칸 밖으로 나가서 한쪽에 붙인다 */
  .mark.end .tip {
    left: auto;
    right: 0;
    transform: translate(0, 2px);
  }

  .mark.end:hover .tip,
  .mark.end:focus-visible .tip {
    transform: translate(0, 0);
  }

  .mark.start .tip {
    left: 0;
    transform: translate(0, 2px);
  }

  .mark.start:hover .tip,
  .mark.start:focus-visible .tip {
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mark::after,
    .tip {
      transition: none;
    }
    .now::after {
      animation: none;
    }
  }
</style>
