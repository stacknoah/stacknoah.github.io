---
// 도형을 그리지 않는다. 글 쓴 날의 날짜 숫자가 그대로 마크다.
// 기준선 위에 숫자들이 활자처럼 앉고, 조판이 곧 그래프가 된다.
//
// 왼쪽 끝이 첫 글, 오른쪽 끝이 오늘이다. 안 쓰면 축이 하루씩 길어지면서
// 숫자들이 왼쪽으로 눌리고, 마지막 숫자와 오늘 사이가 벌어진다.
// 그 빈 줄에는 기준선도 실선을 그만두고 점선만 남으며, 쉰 날수가
// 하루마다 커지는 활자로 앉는다. 쉬는 것이 화면에서 자란다.
//
// 오른쪽 끝의 세로 획은 커서다. 워드마크의 커서와 같은 터키석이고,
// 다음 글자가 찍힐 자리에서 기다린다.

export interface ActivityEntry {
  date: string; // YYYY-MM-DD
  title: string;
  kind: '노트' | '글';
  href: string;
}

interface Props {
  entries: ActivityEntry[];
}

const { entries } = Astro.props;

const DAY = 86400000;

function parseYmd(s: string): Date {
  const [y, m, d] = s.split('-').map(Number);
  return new Date(y, m - 1, d);
}

/** 서머타임이 있는 지역에서도 어긋나지 않게 반올림 */
function daysBetween(a: Date, b: Date): number {
  return Math.round((b.getTime() - a.getTime()) / DAY);
}

function ymd(s: string): string {
  return s.slice(2).replace(/-/g, '.');
}

function fmt(d: Date): string {
  const p = (n: number) => String(n).padStart(2, '0');
  return `${String(d.getFullYear()).slice(2)}.${p(d.getMonth() + 1)}.${p(d.getDate())}`;
}

const sorted = [...entries].sort((a, b) => (a.date < b.date ? -1 : 1));
const n = sorted.length;

const today = new Date();
today.setHours(0, 0, 0, 0);

const first = n > 0 ? parseYmd(sorted[0].date) : today;
const lastD = n > 0 ? daysBetween(first, parseYmd(sorted[n - 1].date)) : 0;
// 시계가 마지막 글보다 뒤에 있어도 축이 뒤집히지 않게
const span = Math.max(1, lastD, daysBetween(first, today));

// 같은 날 두 편이면 숫자가 포개진다. 뒤엣것을 한 글자 폭씩 민다
const seen = new Map<string, number>();
const marks = sorted.map((e, i) => {
  const k = seen.get(e.date) ?? 0;
  seen.set(e.date, k + 1);
  // 달이 바뀌는 첫 글만 달을 함께 적는다. 나머지는 날짜 두 자리
  const prevMonth = i > 0 ? sorted[i - 1].date.slice(0, 7) : e.date.slice(0, 7);
  const withMonth = i > 0 && e.date.slice(0, 7) !== prevMonth;
  return {
    ...e,
    d: daysBetween(first, parseYmd(e.date)),
    dup: k,
    label: withMonth ? e.date.slice(5).replace('-', '.') : e.date.slice(8),
    // 노트와 글을 색이 아니라 굵기로 가른다. 로드맵이 쓴 것과 안 쓴 것을 가르는 문법
    art: e.kind === '글',
  };
});

const idle = span - lastD;
---

<div
  class="activity"
  data-activity
  data-first={n > 0 ? sorted[0].date : ''}
  data-last={String(lastD)}
  style={`--span:${span}; --idle:${idle}; --last:${lastD}`}
>
  <p class="section-label">
    activity
    {
      n > 0 && (
        <Fragment>
          <span class="lead" aria-hidden="true" />
          <span class="tally">
            <b>{n}</b>
            <i>편</i>
          </span>
        </Fragment>
      )
    }
  </p>

  {
    n > 0 && (
      <Fragment>
        <div class="plot">
          {/* 기준선. 기록이 이어진 구간은 실선, 마지막 글부터 오늘까지는 점선 */}
          <span class="ruled" aria-hidden="true" />
          <span class="rest" aria-hidden="true" />

          {/* 쉰 날수. 하루마다 활자가 커진다. 오늘 썼으면 안 나온다 */}
          <span class="gap" data-idle hidden={idle < 1}>
            <b data-idle-n>{idle}</b>
            <i>일째</i>
          </span>

          {/* 오늘. 다음 글자가 찍힐 자리의 커서 */}
          <span class="today" aria-hidden="true" />

          {marks.map((m) => {
            const cls = [
              'm',
              m.art ? 'art' : '',
              m.d > span * 0.85 ? 'end' : '',
              m.d < span * 0.1 ? 'start' : '',
            ]
              .filter(Boolean)
              .join(' ');
            return (
              <a
                class={cls}
                style={`--d:${m.d}; --dup:${m.dup}`}
                href={m.href}
                aria-label={`${ymd(m.date)} ${m.kind} ${m.title}`}
              >
                <span class="num mono">{m.label}</span>
                <span class="tip" aria-hidden="true">
                  <b>{ymd(m.date)}</b>
                  {m.title}
                </span>
              </a>
            );
          })}
          <p class="axis mono" aria-hidden="true">
            <span>{ymd(sorted[0].date)}</span>
            <span data-today>{fmt(today)}</span>
          </p>
        </div>
      </Fragment>
    )
  }
</div>

<script>
  // 축의 오른쪽 끝은 보는 사람의 오늘이다. 정적 사이트라 빌드 날짜로 굳어 있어서
  // 화면에서 다시 잰다. 바뀌는 값은 --span 과 --idle 뿐이고 자리는 CSS 가 계산한다
  const root = document.querySelector<HTMLElement>('[data-activity]');
  const firstStr = root?.dataset.first;

  if (root && firstStr) {
    const [y, m, d] = firstStr.split('-').map(Number);
    const first = new Date(y, m - 1, d);
    const now = new Date();
    now.setHours(0, 0, 0, 0);

    const lastD = Number(root.dataset.last ?? 0);
    const days = Math.round((now.getTime() - first.getTime()) / 86400000);
    const span = Math.max(1, lastD, days);
    const idle = span - lastD;

    root.style.setProperty('--span', String(span));
    root.style.setProperty('--idle', String(idle));

    const box = root.querySelector<HTMLElement>('[data-idle]');
    const num = root.querySelector<HTMLElement>('[data-idle-n]');
    if (box && num) {
      num.textContent = String(idle);
      box.hidden = idle < 1;
    }

    const label = root.querySelector<HTMLElement>('[data-today]');
    if (label) {
      const p = (v: number) => String(v).padStart(2, '0');
      label.textContent = `${String(now.getFullYear()).slice(2)}.${p(now.getMonth() + 1)}.${p(now.getDate())}`;
    }
  }
</script>

<style>
  /* 라벨 오른쪽 값. 숫자와 단위를 같은 크기로 둬서 5편이 한 낱말로 붙는다 */
  .tally {
    display: inline-flex;
    align-items: baseline;
    flex-shrink: 0;
  }

  .tally b {
    font-family: var(--font-mono);
    font-size: var(--t-7);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* 고정폭 스택에 한글이 없다. 여기서 다시 안 잡으면 시스템 글꼴로 떨어진다 */
  .tally i {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--t-7);
    font-weight: 500;
    letter-spacing: var(--track-ko);
    color: var(--ink-3);
    margin-left: -0.02em;
  }

  .plot {
    position: relative;
    height: 205px;
  }

  /* 조판의 기준선을 판 가운데 둔다. 거의 빈 종이에 한 줄이 앉은 구도 */
  .ruled {
    position: absolute;
    left: 0;
    width: calc(var(--last) / var(--span) * 100%);
    bottom: 50%;
    height: 1px;
    background: var(--line-strong);
  }

  /* 마지막 글부터 오늘까지. 선이 끊기고 점만 남는다. 하루 쉴 때마다 길어진다 */
  .rest {
    position: absolute;
    left: calc(var(--last) / var(--span) * 100%);
    right: 0;
    bottom: calc(50% - 0.5px);
    height: 2px;
    background-image: radial-gradient(
      circle at right center,
      var(--line-strong) 1px,
      transparent 1.5px
    );
    background-size: 6px 2px;
    background-position: right center;
    background-repeat: repeat-x;
  }

  /* 글 한 편. 날짜 숫자가 기준선 위에 활자처럼 앉는다 */
  .m {
    position: absolute;
    left: calc(var(--d) / var(--span) * 100%);
    bottom: 50%;
    transform: translateX(calc(-50% + var(--dup) * 1.3em));
    padding: 0.75rem 0.5rem 0.375rem;
    display: block;
  }

  .m:hover,
  .m:focus-visible {
    z-index: 3;
  }

  .m:focus-visible {
    outline: none;
  }

  .num {
    display: block;
    font-size: var(--t-4);
    font-weight: 500;
    letter-spacing: var(--track-en);
    line-height: 1;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    transition: color var(--out) ease, transform var(--out) var(--ease);
  }

  /* 글은 노트보다 무겁다. 로드맵이 쓴 것과 안 쓴 것을 가르는 그 문법 */
  .m.art .num {
    font-weight: 700;
    color: var(--ink);
  }

  .m:hover .num,
  .m:focus-visible .num {
    color: var(--accent-ink);
    transform: translateY(calc(var(--slide) * -1));
    transition-duration: var(--in);
  }

  /* 양 끝 숫자는 판 밖으로 반이 나가서 한쪽을 벽에 붙인다 */
  .m.start {
    transform: translateX(calc(-0.5rem + var(--dup) * 1.3em));
  }

  .m.end {
    transform: translateX(calc(-100% + 0.5rem + var(--dup) * 1.3em));
  }

  /* 쉰 날수. 며칠째 비어 있는 줄인지가 활자 크기로 자란다 */
  .gap {
    position: absolute;
    left: calc(var(--last) / var(--span) * 100%);
    right: 0;
    bottom: calc(50% + 0.375rem);
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.12em;
    white-space: nowrap;
    pointer-events: none;
  }

  .gap[hidden] {
    display: none;
  }

  .gap b {
    font-family: var(--font-mono);
    font-weight: 500;
    /* 하루 0.2rem 씩. 열흘을 넘기면 라벨 오른쪽 편수보다 큰 활자가 된다 */
    font-size: clamp(1rem, calc(0.875rem + var(--idle) * 0.2rem), 3.25rem);
    line-height: 1;
    letter-spacing: 0;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .gap i {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--t-7);
    font-weight: 500;
    letter-spacing: var(--track-ko);
    color: var(--ink-3);
  }

  /* 오늘. 다음 글자 자리에서 기다리는 커서라 글자 키만큼만 서 있다.
     워드마크 커서처럼 세 번 깜박이고 멈춘다 */
  .today {
    position: absolute;
    right: 0;
    bottom: calc(50% + 0.25rem);
    width: 2px;
    height: 1.5em;
    background: var(--accent-mid);
    border-radius: 0.8px;
    animation: blink 1.2s steps(1) 3;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* 축 양 끝. 왼쪽이 첫 글, 오른쪽이 오늘. 기준선 바로 아래 붙어서
     날짜 숫자들과 한 덩어리로 읽힌다 */
  .axis {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + 0.75rem);
    display: flex;
    justify-content: space-between;
    margin: 0;
    font-size: var(--t-8);
    line-height: 1.4;
    letter-spacing: var(--track-en);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* 제목은 손이 닿을 때만. 쉬는 화면에 글자를 늘리지 않는다 */
  .tip {
    position: absolute;
    z-index: 5;
    left: 50%;
    bottom: calc(100% + 2px);
    transform: translate(-50%, 2px);
    width: max-content;
    max-width: 15rem;
    background: var(--bg);
    color: var(--ink);
    border-radius: 7px;
    padding: 0.4rem 0.6rem;
    font-size: var(--t-8);
    font-weight: 400;
    line-height: 1.5;
    word-break: keep-all;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 0 0 1px var(--line-strong), 0 2px 12px rgba(26, 26, 25, 0.06);
    transition: opacity var(--out) ease, transform var(--out) var(--ease);
  }

  .tip b {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: var(--track-en);
    margin-right: 0.35rem;
  }

  .m:hover .tip,
  .m:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .m.start .tip {
    left: 0;
    transform: translate(0, 2px);
  }

  .m.end .tip {
    left: auto;
    right: 0;
    transform: translate(0, 2px);
  }

  .m.start:hover .tip,
  .m.start:focus-visible .tip,
  .m.end:hover .tip,
  .m.end:focus-visible .tip {
    transform: translate(0, 0);
  }

  /* 좁은 화면에서는 두 칸이 세로로 쌓여서 옆 칸과 바닥을 맞출 일이 없다.
     빈 위 여백만 줄인다 */
  @media (max-width: 960px) {
    .plot {
      height: 150px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .num,
    .tip {
      transition: none;
    }
    .today {
      animation: none;
    }
  }
</style>
