---
// 시간 한 줄에 기록을 세운다. 왼쪽 끝이 첫 글, 오른쪽 끝이 오늘.
// 글 한 편이 획 하나고, 획은 지워지지 않는다. 쌓인 편수는 획의 수와 빽빽함이다.
//
// 오른쪽 끝을 오늘로 잡는다. 안 쓰면 축이 하루씩 길어지면서 지금까지 쓴 것이
// 왼쪽으로 눌리고, 마지막 획과 오늘 사이가 벌어진다. 쉬는 것이 화면에서
// 자란다. 이게 이 구역이 하는 일이다.
//
// 안 쓴 날을 칸으로 그리지는 않는다. 벌어지는 것은 면적이 아니라 간격 하나다.
// 지난 격자는 180칸 중 175칸이 비어서, 볼 때마다 안 쓴 날을 먼저 봤다.

export interface ActivityEntry {
  date: string; // YYYY-MM-DD
  title: string;
  kind: '노트' | '글';
  href: string;
}

interface Props {
  entries: ActivityEntry[];
}

const { entries } = Astro.props;

const DAY = 86400000;

function parseYmd(s: string): Date {
  const [y, m, d] = s.split('-').map(Number);
  return new Date(y, m - 1, d);
}

/** 서머타임이 있는 지역에서도 어긋나지 않게 반올림 */
function daysBetween(a: Date, b: Date): number {
  return Math.round((b.getTime() - a.getTime()) / DAY);
}

function ymd(s: string): string {
  return s.slice(2).replace(/-/g, '.');
}

function fmt(d: Date): string {
  const p = (n: number) => String(n).padStart(2, '0');
  return `${String(d.getFullYear()).slice(2)}.${p(d.getMonth() + 1)}.${p(d.getDate())}`;
}

const sorted = [...entries].sort((a, b) => (a.date < b.date ? -1 : 1));
const n = sorted.length;

const today = new Date();
today.setHours(0, 0, 0, 0);

const first = n > 0 ? parseYmd(sorted[0].date) : today;
const lastD = n > 0 ? daysBetween(first, parseYmd(sorted[n - 1].date)) : 0;
// 시계가 마지막 글보다 뒤에 있어도 축이 뒤집히지 않게
const span = Math.max(1, lastD, daysBetween(first, today));

// 획 하나를 손으로 고르려면 10px 은 있어야 한다. 그보다 촘촘해지면 링크를 접는다
const interactive = n > 0 && 660 / n >= 10;

// 같은 날 두 편이면 겹쳐서 한 획으로 보인다. 3px 씩 밀어 둘로 보이게 한다
const seen = new Map<string, number>();
const strokes = sorted.map((e) => {
  const k = seen.get(e.date) ?? 0;
  seen.set(e.date, k + 1);
  return {
    ...e,
    d: daysBetween(first, parseYmd(e.date)),
    dup: k,
    // 노트와 글을 색이 아니라 획 높이로 가른다. 흑백으로 찍어도 같게 읽힌다
    h: e.kind === '글' ? 78 : 62,
  };
});

const idle = span - lastD;
---

<div
  class="activity"
  data-activity
  data-first={n > 0 ? sorted[0].date : ''}
  data-last={String(lastD)}
  style={`--span:${span}; --last:${lastD}`}
>
  <p class="section-label">
    activity
    {
      n > 0 && (
        <Fragment>
          <span class="lead" aria-hidden="true" />
          <span class="tally">
            <b>{n}</b>
            <i>편</i>
          </span>
        </Fragment>
      )
    }
  </p>

  {
    n > 0 && (
      <Fragment>
        <div
          class="plot"
          role={interactive ? undefined : 'img'}
          aria-label={
            interactive
              ? undefined
              : `글 ${n}편, ${ymd(sorted[0].date)}부터 ${ymd(sorted[n - 1].date)}까지`
          }
        >
          {/* 기록이 이어진 구간은 실선, 마지막 글부터 오늘까지는 점선 */}
          <span class="ruled" aria-hidden="true" />
          <span class="rest" aria-hidden="true" />

          {/* 쉰 날수. 오늘 썼으면 안 나온다 */}
          <span class="idle" data-idle hidden={idle < 1}>
            <b data-idle-n>{idle}</b>
            <i>일째</i>
          </span>

          {/* 오늘 */}
          <span class="today" aria-hidden="true" />

          {strokes.map((s) => {
            const cls = [
              's',
              s.d > span * 0.78 ? 'end' : '',
              s.d < span * 0.22 ? 'start' : '',
            ]
              .filter(Boolean)
              .join(' ');
            const style = `--d:${s.d}; --h:${s.h}%; --dup:${s.dup}`;
            const inner = (
              <Fragment>
                <span class="bar" aria-hidden="true" />
                {interactive && (
                  <span class="tip" aria-hidden="true">
                    <b>{ymd(s.date)}</b>
                    {s.title}
                  </span>
                )}
              </Fragment>
            );
            return interactive ? (
              <a
                class={cls}
                style={style}
                href={s.href}
                aria-label={`${ymd(s.date)} ${s.kind} ${s.title}`}
              >
                {inner}
              </a>
            ) : (
              <span class={cls} style={style}>
                {inner}
              </span>
            );
          })}
        </div>

        <p class="axis mono" aria-hidden="true">
          <span>{ymd(sorted[0].date)}</span>
          <span data-today>{fmt(today)}</span>
        </p>
      </Fragment>
    )
  }
</div>

<script>
  // 축의 오른쪽 끝은 보는 사람의 오늘이다. 정적 사이트라 빌드 날짜로 굳어 있어서
  // 화면에서 다시 잰다. 바뀌는 값은 축 길이 하나뿐이라 CSS 변수 하나만 고친다
  const root = document.querySelector<HTMLElement>('[data-activity]');
  const firstStr = root?.dataset.first;

  if (root && firstStr) {
    const [y, m, d] = firstStr.split('-').map(Number);
    const first = new Date(y, m - 1, d);
    const now = new Date();
    now.setHours(0, 0, 0, 0);

    const lastD = Number(root.dataset.last ?? 0);
    const days = Math.round((now.getTime() - first.getTime()) / 86400000);
    const span = Math.max(1, lastD, days);

    root.style.setProperty('--span', String(span));

    const idle = span - lastD;
    const box = root.querySelector<HTMLElement>('[data-idle]');
    const num = root.querySelector<HTMLElement>('[data-idle-n]');
    if (box && num) {
      num.textContent = String(idle);
      box.hidden = idle < 1;
    }

    const label = root.querySelector<HTMLElement>('[data-today]');
    if (label) {
      const p = (v: number) => String(v).padStart(2, '0');
      label.textContent = `${String(now.getFullYear()).slice(2)}.${p(now.getMonth() + 1)}.${p(now.getDate())}`;
    }
  }
</script>

<style>
  /* 라벨 오른쪽 값. 숫자와 단위를 같은 크기로 둬서 5편이 한 낱말로 붙는다 */
  .tally,
  .idle {
    display: inline-flex;
    align-items: baseline;
    flex-shrink: 0;
  }

  .tally b,
  .idle b {
    font-family: var(--font-mono);
    font-size: var(--t-7);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  /* 고정폭 스택에 한글이 없다. 여기서 다시 안 잡으면 시스템 글꼴로 떨어진다 */
  .tally i,
  .idle i {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: var(--t-7);
    font-weight: 500;
    letter-spacing: var(--track-ko);
    color: var(--ink-3);
    margin-left: -0.02em;
  }

  .plot {
    position: relative;
    height: 180px;
  }

  /* 기록이 이어진 구간. 첫 글부터 마지막 글까지 */
  .ruled {
    position: absolute;
    left: 0;
    width: calc(var(--last) / var(--span) * 100%);
    bottom: 0;
    height: 1px;
    background: var(--line-strong);
  }

  /* 마지막 글부터 오늘까지. 선이 끊기고 점만 남는다. 하루 쉴 때마다 길어진다 */
  .rest {
    position: absolute;
    left: calc(var(--last) / var(--span) * 100%);
    right: 0;
    bottom: 0;
    height: 2px;
    background-image: radial-gradient(
      circle at right center,
      var(--line-strong) 1px,
      transparent 1.5px
    );
    background-size: 6px 2px;
    background-position: right center;
    background-repeat: repeat-x;
  }

  /* 쉰 날수. 점선 구간 한가운데 앉는다 */
  .idle {
    position: absolute;
    bottom: 0.625rem;
    left: calc((var(--last) / var(--span) * 100%) + (100% - var(--last) / var(--span) * 100%) / 2);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .idle[hidden] {
    display: none;
  }

  /* 오늘. 판에서 가장 높고 유일하게 색이 있는 세로 획이다 */
  .today {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 2px;
    height: 100%;
    background: var(--accent-mid);
    border-radius: 0.8px;
  }

  /* 글 한 편. 손이 잡을 자리를 넓게 두고 그 안에 획만 보인다 */
  .s {
    position: absolute;
    left: calc(var(--d) / var(--span) * 100% + var(--dup) * 3px);
    bottom: 0;
    width: 14px;
    height: 100%;
    margin-left: -6px;
    display: block;
  }

  .s:hover,
  .s:focus-visible {
    z-index: 3;
  }

  .bar {
    position: absolute;
    left: 6px;
    bottom: 0;
    width: 2px;
    height: var(--h);
    border-radius: 0.8px;
    background: var(--ink-3);
    transition: background var(--out) ease, height var(--out) var(--ease);
  }

  .s:hover .bar,
  .s:focus-visible .bar {
    background: var(--accent-strong);
    height: calc(var(--h) + 8%);
    transition-duration: var(--in);
  }

  .s:focus-visible {
    outline: none;
  }

  /* 축 양 끝. 왼쪽이 첫 글, 오른쪽이 오늘 */
  .axis {
    display: flex;
    justify-content: space-between;
    margin: 0.625rem 0 0;
    font-size: var(--t-8);
    line-height: 1.4;
    letter-spacing: var(--track-en);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* 제목은 손이 닿을 때만. 쉬는 화면에 글자를 늘리지 않는다 */
  .tip {
    position: absolute;
    z-index: 5;
    left: 7px;
    bottom: calc(var(--h) + 10px);
    transform: translate(-50%, 2px);
    width: max-content;
    max-width: 15rem;
    background: var(--bg);
    color: var(--ink);
    border-radius: 7px;
    padding: 0.4rem 0.6rem;
    font-size: var(--t-8);
    line-height: 1.5;
    word-break: keep-all;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 0 0 1px var(--line-strong), 0 2px 12px rgba(26, 26, 25, 0.06);
    transition: opacity var(--out) ease, transform var(--out) var(--ease);
  }

  .tip b {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: var(--track-en);
    margin-right: 0.35rem;
  }

  .s:hover .tip,
  .s:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* 양 끝 획은 말풍선이 판 밖으로 나가서 한쪽에 붙인다 */
  .s.start .tip {
    left: 0;
    transform: translate(0, 2px);
  }

  .s.end .tip {
    left: auto;
    right: 0;
    transform: translate(0, 2px);
  }

  .s.start:hover .tip,
  .s.start:focus-visible .tip,
  .s.end:hover .tip,
  .s.end:focus-visible .tip {
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .tip {
      transition: none;
    }
  }
</style>
