---
import { resolveAttachments, type Attachment } from '../lib/attachments';

interface Props {
  items?: Attachment[];
}

const files = resolveAttachments(Astro.props.items ?? []);
---

{
  files.length > 0 && (
    <section class="files">
      <p class="section-label">files</p>
      <ul>
        {files.map((f) => (
          <li>
            <a href={f.href} download>
              {f.ext && <span class="ext mono">{f.ext}</span>}
              <span class="name">{f.name}</span>
              <span class="leader" aria-hidden="true" />
              <span class="size mono">{f.size ?? '없음'}</span>
              <span class="go" aria-hidden="true">↓</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .files {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.4rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: 6px;
    font-size: var(--t-5);
    transition: background var(--out) ease;
  }

  a:hover {
    background: var(--surface);
    transition-duration: var(--in);
  }

  /* 확장자를 앞에 세워 무슨 파일인지 먼저 읽히게 */
  .ext {
    flex-shrink: 0;
    min-width: 2.5rem;
    font-size: var(--t-8);
    letter-spacing: var(--track-en);
    color: var(--ink-3);
  }

  .name {
    color: var(--ink);
    font-weight: 500;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  a:hover .name {
    color: var(--accent-ink);
  }

  .leader {
    flex: 1 1 auto;
    min-width: 1rem;
    align-self: center;
    height: 2px;
    background-image: radial-gradient(circle, var(--line-strong) 1px, transparent 1px);
    background-size: 6px 2px;
    background-repeat: repeat-x;
    opacity: 0.7;
  }

  .size {
    flex-shrink: 0;
    font-size: var(--t-8);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .go {
    flex-shrink: 0;
    width: 0.75rem;
    font-size: 0.8125rem;
    color: var(--accent-ink);
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity var(--out) ease, transform var(--out) var(--ease);
  }

  a:hover .go {
    opacity: 1;
    transform: none;
    transition-duration: var(--in);
  }

  @media (max-width: 560px) {
    .leader {
      display: none;
    }
    .size {
      margin-left: auto;
    }
  }
</style>
